@using FinanceApp.Models
@model FinancialAccount

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title pt-2 pb-0">Edit Financial Account</h5>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="row mb-3">
                            <label asp-for="AccountTypeId" class="col-sm-2 col-form-label">Account Type</label>
                            <div class="col-sm-10">
                                <select name="AccountTypeId" asp-for="AccountTypeId" class="form-select" asp-items="@(new SelectList(ViewBag.AccountTypes, "Id", "Name"))">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="AccountTypeId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="AccountBalance" class="col-sm-2 col-form-label">Account Balance</label>
                            <div class="col-sm-10">
                                <input type="number" asp-for="AccountBalance" class="form-control">
                                <span asp-validation-for="AccountBalance" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Bank" class="col-sm-2 col-form-label">Bank</label>
                            <div class="col-sm-10">
                                <input type="text" asp-for="Bank" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-10">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}