@using FinanceApp.Models
@model Transaction

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title pt-2 pb-0">Add Transaction</h5>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row mb-3">
                            <label asp-for="Description" class="col-sm-3 col-form-label">Description</label>
                            <div class="col-sm-9">
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Amount" class="col-sm-3 col-form-label">Amount</label>
                            <div class="col-sm-9">
                                <input type="number" asp-for="Amount" class="form-control">
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="CategoryId" class="col-sm-3 col-form-label">Category</label>
                            <div class="col-sm-9">
                                <select name="CategoryId" asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="TransactionDate" class="col-sm-3 col-form-label">Transaction Date</label>
                            <div class="col-sm-9">
                                <input type="date" asp-for="TransactionDate" class="form-control">
                                <span asp-validation-for="TransactionDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="PaymentMethodId" class="col-sm-3 col-form-label">Payment Method</label>
                            <div class="col-sm-9">
                                <select name="PaymentMethodId" asp-for="PaymentMethodId" class="form-select" asp-items="@(new SelectList(ViewBag.PaymentMethods, "Id", "Name"))">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-9">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}