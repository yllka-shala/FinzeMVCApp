@using System.Security.Claims
@{
    string name = User.FindFirstValue(ClaimTypes.Name);
    string surname = User.FindFirstValue(ClaimTypes.Surname);
    string fullname = name + " " + surname;
    string profileImage = User.FindFirstValue("ProfileImage");

    bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = User?.IsInRole("Admin") ?? false;
    bool isCustomer = User?.IsInRole("Customer") ?? false;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finzë</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <!-- Favicons -->
    <link href="~/Theme/assets/img/favicon1.png" rel="icon">
    <link href="~/Theme/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/Theme/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Theme/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="~/Theme/assets/css/style.css" rel="stylesheet">
</head>
<body>

    <!-- ======= Header ======= -->
    <header id="header" class="header fixed-top d-flex align-items-center">

        <div class="d-flex align-items-center justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                <img src="~/Theme/assets/img/logoTest.png" alt="">
                <span class="d-none d-lg-block">Finzë</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div><!-- End Logo -->

        <div class="search-bar">
            <form class="search-form d-flex align-items-center" 
                  method="get" 
                  asp-controller="@ViewContext.RouteData.Values["controller"]" 
                  asp-action="@ViewContext.RouteData.Values["action"]">
                <input type="text" 
                       name="search" 
                       placeholder="Search" 
                       title="Enter search keyword" 
                       value="@Context.Request.Query["search"]">
                <button type="submit" title="Search"><i class="bi bi-search"></i></button>
            </form>
        </div><!-- End Search Bar -->

        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">

                <li class="nav-item d-block d-lg-none">
                    <a class="nav-link nav-icon search-bar-toggle " href="#">
                        <i class="bi bi-search"></i>
                    </a>
                </li><!-- End Search Icon-->

                @await Component.InvokeAsync("GetNotifications")
             
                <li class="nav-item dropdown pe-3">

                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">                     
                        @if (isAuthenticated)
                        {
                            if (!string.IsNullOrEmpty(profileImage))
                            {
                                <img src="~/Images/@profileImage" alt="Profile" class="rounded-circle" width="30" height="30">
                            }
                            else
                            {
                                <img src="~/Theme/assets/img/profile.png" alt="Profile" class="rounded-circle" width="30" height="30">
                            }
                           
                            <span class="d-none d-md-block dropdown-toggle ps-2">@name</span>
                        }
                    </a><!-- End Profile Iamge Icon -->

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            @if (isAuthenticated)
                            {
                                <h6>@fullname</h6>
                            }
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-action="AccountSettings" asp-controller="User">
                                <i class="bi bi-gear"></i>
                                <span>Account Settings</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-action="Help" asp-controller="Home">
                                <i class="bi bi-question-circle"></i>
                                <span>Need Help?</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-action="Logout" asp-controller="Home">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sign Out</span>
                            </a>
                        </li>

                    </ul><!-- End Profile Dropdown Items -->
                </li><!-- End Profile Nav -->

            </ul>
        </nav><!-- End Icons Navigation -->

    </header><!-- End Header -->
    <!-- ======= Sidebar ======= -->
    <aside id="sidebar" class="sidebar">

        <ul class="sidebar-nav" id="sidebar-nav">

            <li class="nav-item">
                <a class="nav-link @(currentController == "Home" ? "active" : "collapsed")" 
                    asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>
            </li><!-- End Dashboard Nav -->

            <li class="nav-heading">Pages</li>

            <li class="nav-item">
                <a class="nav-link @(currentController == "Budget" ? "active" : "collapsed")" 
                    asp-controller="Budget" asp-action="Index">
                    <i class="bi bi-cash-coin"></i>
                    <span>Budget</span>
                </a>
            </li><!-- End Budget Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "Transaction" ? "active" : "collapsed")" 
                    asp-controller="Transaction" asp-action="Index">
                    <i class="bi bi-cash-stack"></i>
                    <span>Transactions</span>
                </a>
            </li><!-- End Transactions Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "Category" ? "active" : "collapsed")" 
                    asp-controller="Category" asp-action="Index">
                    <i class="bi bi-layout-text-window-reverse"></i>
                    <span>Category</span>
                </a>
            </li><!-- End Category Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "BillReminder" ? "active" : "collapsed")" 
                    asp-controller="BillReminder" asp-action="Index">
                    <i class="bi bi-pin-angle"></i>
                    <span>Bill Reminder</span>
                </a>
            </li><!-- End Bill Reminder Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "Goal" ? "active" : "collapsed")" 
                    asp-controller="Goal" asp-action="Index">
                    <i class="bi bi-bookmark-heart"></i>
                    <span>Goal</span>
                </a>
            </li><!-- End Goal Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "Recurring" ? "active" : "collapsed")" 
                    asp-controller="Recurring" asp-action="Index">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Recurring</span>
                </a>
            </li><!-- End Recurring Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "FinancialAccount" ? "active" : "collapsed")" 
                    asp-controller="FinancialAccount" asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Financial Account</span>
                </a>
            </li><!-- End Financial Account Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "CustomerReports" ? "active" : "collapsed")"
                   asp-controller="CustomerReports" asp-action="Index">
                    <i class="bi bi-bar-chart"></i>
                    <span>Reports/Charts</span>
                </a>
            </li><!-- Reports Page Nav -->

            <li class="nav-item">
                <a class="nav-link @(currentController == "Notification" ? "active" : "collapsed")" 
                    asp-controller="Notification" asp-action="Index">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>
            </li><!-- End Notifications Page Nav -->

             @if (isAdmin)
             {
                <li class="nav-item">
                    <a class="nav-link @(currentController == "User" ? "active" : "collapsed")" 
                        asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                </li><!-- End Users Page Nav -->
            }

        </ul>

    </aside><!-- End Sidebar-->

    <main id="main" class="main">
        <section class="section dashboard">
            <div class="row">
                <partial name="_Notifications" />
                @RenderBody()
            </div>
        </section>

    </main><!-- End #main -->
    <!-- ======= Footer ======= -->
    <footer id="footer" class="footer">
        <div class="copyright">
            &copy; Copyright <strong><span>Finzë - 2026</span></strong>. Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
        </div>
    </footer><!-- End Footer -->

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Vendor JS Files -->

    <script src="~/Theme/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Theme/assets/js/main.js"></script>
    <script src="~/Theme/assets/js/customjs.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/theme/assets/js/charthandler.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
