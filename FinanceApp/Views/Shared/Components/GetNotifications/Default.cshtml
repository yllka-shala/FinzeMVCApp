@model IEnumerable<Notification>

<li class="nav-item dropdown">

    @{
        var notificationsNumber = Model?.Count() ?? 0;
    }

    <a class="nav-link nav-icon" href="#" data-bs-toggle="dropdown">
        <i class="bi bi-bell"></i>
        <span class="badge bg-primary badge-number">@notificationsNumber</span>
    </a>

    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications">

        <li class="dropdown-header">
            You have @notificationsNumber new notifications
            <a asp-action="ClearAll" asp-controller="Notification">
                <span class="badge rounded-pill bg-primary p-2 ms-2">Clear all</span>
            </a>
        </li>

        <li><hr class="dropdown-divider"></li>

        @foreach (var item in Model)
        {
            <li class="notification-item">
                <i class="bi bi-exclamation-circle text-warning"></i>
                <div>
                    <h4>@item.NotificationType.Name</h4>
                    <p>@item.Message</p>
                </div>
            </li>

            <li><hr class="dropdown-divider"></li>
        }

        <li class="dropdown-footer">
            <a asp-action="Index" asp-controller="Notification">Show all notifications</a>
        </li>

    </ul>
</li>
