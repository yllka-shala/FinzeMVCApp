@using FinanceApp.Models
@model Goal

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title pt-2 pb-0">Edit Goal</h5>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="row mb-3">
                            <label asp-for="Name" class="col-sm-3 col-form-label">Name</label>
                            <div class="col-sm-9">
                                <input type="text" asp-for="Name" class="form-control">
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="TargetAmount" class="col-sm-3 col-form-label">Target Amount</label>
                            <div class="col-sm-9">
                                <input type="number" asp-for="TargetAmount" class="form-control">
                                <span asp-validation-for="TargetAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="CurrentAmount" class="col-sm-3 col-form-label">Current Amount</label>
                            <div class="col-sm-9">
                                <input type="number" asp-for="CurrentAmount" class="form-control">
                                <span asp-validation-for="CurrentAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="DueDate" class="col-sm-3 col-form-label">Due Date</label>
                            <div class="col-sm-9">
                                <input type="date" asp-for="DueDate" class="form-control">
                                <span asp-validation-for="DueDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-9">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}