
<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title pt-2 pb-0">Account Settings</h5>
                </div>
                <div class="card-body pt-3">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Edit Profile</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="password-tab" data-bs-toggle="tab" data-bs-target="#password" type="button" role="tab" aria-controls="password" aria-selected="true">Change Password</button>
                        </li>
                    </ul>
                    <div class="tab-content pt-2" id="myTabContent">
                        <div class="tab-pane fade show active" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                            <div class="pt-4">
                                <a asp-action="Profile" asp-controller="User">
                                    <div class="card col-3">
                                        <img src="~/Theme/assets/img/user.png" class="card-img-top" alt="...">
                                        <div class="card-img-overlay d-flex justify-content-center align-items-center">
                                            <h5 class="card-title text-center">My Profile</h5>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            
                        </div>
                        <div class="tab-pane fade" id="password" role="tabpanel" aria-labelledby="password-tab">
                            <div class="pt-4">
                                <a asp-action="ChangePassword" asp-controller="User">
                                    <div class="card col-3">
                                        <img src="~/Theme/assets/img/lock.png" class="card-img-top" alt="...">
                                        <div class="card-img-overlay d-flex justify-content-center align-items-center">
                                            <h5 class="card-title text-center">My Password</h5>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>