@using FinanceApp.Models
@model Notification

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title pt-2 pb-0">Edit Notification</h5>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="row mb-3">
                            <label asp-for="NotificationTypeId" class="col-sm-3 col-form-label">Notification Type</label>
                            <div class="col-sm-9">
                                <select name="NotificationTypeId" asp-for="NotificationTypeId" class="form-select" asp-items="@(new SelectList(ViewBag.NotificationType, "Id", "Name"))">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="NotificationTypeId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Message" class="col-sm-3 col-form-label">Message</label>
                            <div class="col-sm-9">
                                <textarea asp-for="Message" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Message" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Read" class="col-sm-3 form-check-label">Read</label>
                            <div class="col-sm-9">
                                <div class="form-check">
                                    <input asp-for="Read" class="form-check-input" type="checkbox">
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-9">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}