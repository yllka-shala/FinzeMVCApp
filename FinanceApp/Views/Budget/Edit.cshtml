@using FinanceApp.Models
@model Budget

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title pt-2 pb-0">Edit Budget</h5>
                </div>
                <div class="card-body pt-3">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="row mb-3">
                            <label asp-for="CategoryId" class="col-sm-3 col-form-label">Category</label>
                            <div class="col-sm-9">
                                <select name="CategoryId" asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Category, "Id", "Name"))">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Limit" class="col-sm-3 col-form-label">Limit</label>
                            <div class="col-sm-9">
                                <input id="limit" type="number" asp-for="Limit" class="form-control">
                                <span asp-validation-for="Limit" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="CurrentSpent" class="col-sm-3 col-form-label">Spent</label>
                            <div class="col-sm-9">
                                <input id="currentSpent" type="number" asp-for="CurrentSpent" class="form-control" readonly>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label asp-for="Remaining" class="col-sm-3 col-form-label">Remaining</label>
                            <div class="col-sm-9">
                                <input id="remaining" type="number" asp-for="Remaining" class="form-control" readonly>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-9">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
     function calculateTotal() {
        const limit = document.getElementById("limit").value;
        const currentSpent = document.getElementById("currentSpent").value;
        const remaining = limit - currentSpent;

        document.getElementById("remaining").value = remaining.toFixed(2);
    }

    document.getElementById("limit").addEventListener("input", calculateTotal);
    document.getElementById("currentSpent").addEventListener("input", calculateTotal);
</script>